{
  "expo": {
    "name": "Reeldex",
    "slug": "reeldex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reeldex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.reeldex"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E9F5A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.reeldex"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E9F5A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1
          },
          "iosShareExtensionName": "Reeldex",
          "androidIntentFilters": [
            "text/*",
            "video/*"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "Reeldex",
                  "bundleIdentifier": "app.reeldex.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.reeldex"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "69f076bc-f3dc-4c3c-aec8-290e8faa4ae9"
      }
    },
    "owner": "ishaanmittal07"
  }
}
