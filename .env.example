# Copy to .env and fill in. Never commit .env.
# Google AI Studio key (https://aistudio.google.com/apikey). You must be 18+.
GEMINI_API_KEY=
# Model names change often; keep them in config, not code (plan 5.1).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_BUDGET=gemini-3.5-flash-lite
# Personal ingest token for the iOS Shortcut / curl tests. Get one with:
#   select public.admin_create_ingest_token('you@example.com');
REELDEX_TOKEN=
# Web app (public values, inlined into the bundle). Use the publishable key, never the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
